+/// A readonly lookup is valid only for one explicitly named device, without an extra path suffix.
+pub(crate) fn parse_get_device_passthrough(
+    id: Option<&str>,
+    trailing: Option<&str>,
+) -> Result<ParsedRequest, RequestError> {
+    if trailing.is_some() {
+        return Err(RequestError::InvalidID);
+    }
+    let id = checked_id(id.ok_or(RequestError::EmptyID)?)?;
+    let mut owned = String::new();
+    owned.try_reserve_exact(id.len()).map_err(|_| {
+        RequestError::Generic(
+            StatusCode::InternalServerError,
+            "attachment request allocation refused".to_owned(),
+        )
+    })?;
+    owned.push_str(id);
+    Ok(ParsedRequest::new_sync(VmmAction::GetPassthroughDevice(
+        owned,
+    )))
+}
