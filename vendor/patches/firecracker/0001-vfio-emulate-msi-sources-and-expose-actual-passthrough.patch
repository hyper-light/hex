+fn vfio_interrupt_fds(vectors: &MsixVectorGroup, count: usize) -> Result<Vec<&EventFd>, VfioError> {
+    if count == 0 || count > vectors.vectors.len() {
+        return Err(VfioError::NoMsiIrq);
+    }
