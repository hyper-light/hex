+            ),
+            "{:?}",
+            silent.as_ref().err()
+        );
+        assert!(listener.accept().is_ok(), "its one connection");
+        assert!(
+            matches!(listener.accept(), Err(ref why) if why.kind() == io::ErrorKind::WouldBlock),
+            "no second dial"
+        );
+        assert!(!lock(&shared.state).ready);
+    }
