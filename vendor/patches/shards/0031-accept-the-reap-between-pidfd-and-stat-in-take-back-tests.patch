Subject: Accept the reap between pidfd and stat in take-back tests
Why: AC-T7.4.1: after a stopped guest is reaped, re-attach refuses it; the two take-back tests accepted the reap landing before the pidfd open, the exit registration or the stat read (ESRCH) but not between the pidfd and stat opens, where /proc/<pid>/stat is ENOENT. Both flaked on main with that typed refusal.

diff --git a/crates/api/src/client.rs b/crates/api/src/client.rs
index ecfd09ec46c9dd5d90bfb84ae56cafe18c3214fe..f69e90b4eff6b710ae2eeca6aecf617873b1079c 100644
--- a/crates/api/src/client.rs
+++ b/crates/api/src/client.rs
@@ -3643,6 +3643,10 @@ mod tests {
             pid, expected_started, failure: crate::ProcessFailure::Exited | crate::ProcessFailure::Os {
                 operation: crate::ProcessOperation::PidfdOpen | crate::ProcessOperation::RegisterExit | crate::ProcessOperation::ReadStat,
                 code: libc::ESRCH,
+            } | crate::ProcessFailure::Os {
+                // Reaped between its pidfd's open and its stat's: its /proc entry is gone.
+                operation: crate::ProcessOperation::OpenStat,
+                code: libc::ENOENT,
             }
         }) if pid == identity.pid && expected_started == identity.started),
             "{:?}",
@@ -3784,6 +3788,10 @@ mod tests {
             pid, expected_started, failure: crate::ProcessFailure::Exited | crate::ProcessFailure::Os {
                 operation: crate::ProcessOperation::PidfdOpen | crate::ProcessOperation::RegisterExit | crate::ProcessOperation::ReadStat,
                 code: libc::ESRCH,
+            } | crate::ProcessFailure::Os {
+                // Reaped between its pidfd's open and its stat's: its /proc entry is gone.
+                operation: crate::ProcessOperation::OpenStat,
+                code: libc::ENOENT,
             }
         }) if pid == identity.pid && expected_started == identity.started),
             "{:?}",
