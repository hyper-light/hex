-MINGW64_NT-*-x86_64 | MSYS_NT-*-x86_64) host=Windows-x86_64 ;;
+MINGW*_NT-* | MSYS_NT-* | CYGWIN_NT-*)
+    case ${SHARDS_GPU_TARGET:-${VSCMD_ARG_TGT_ARCH:-${PROCESSOR_ARCHITEW6432:-${PROCESSOR_ARCHITECTURE:-x86_64}}}} in
