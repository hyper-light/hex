+    x86_64-pc-windows-msvc | x86_64 | x64 | AMD64) host=Windows-x86_64 ;;
+    *) echo "SHARDS_GPU_TARGET must name Windows amd64 or arm64" >&2; exit 2 ;;
+    esac
+    ;;
 esac
