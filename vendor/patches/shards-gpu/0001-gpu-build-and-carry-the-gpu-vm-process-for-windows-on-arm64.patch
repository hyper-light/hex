+Darwin-arm64 | Linux-x86_64 | Linux-aarch64 | Windows-x86_64 | Windows-aarch64) ;;
 *)
-    echo "the GPU's renderer is built on Apple silicon, on Linux and on x86_64 Windows (D144, D201, D202), not $host" >&2
+    echo "the GPU's renderer is built on Apple silicon, on Linux and on amd64/arm64 Windows (D144, D201, D202), not $host" >&2
     exit 2
     ;;
 esac
