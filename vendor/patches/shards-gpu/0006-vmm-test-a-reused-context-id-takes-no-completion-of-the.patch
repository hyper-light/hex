Subject: vmm test a reused context id takes no completion of the destroyed one
Why: AC-T7.4.1: the regression test that a context id reused after its context is destroyed takes no fence completion queued for the destroyed one (the GPU peer's context-id reuse). Shards commit cb75374d.

diff --git a/crates/vmm/src/devices/virtio/gpu/mod.rs b/crates/vmm/src/devices/virtio/gpu/mod.rs
index 40a40575add47ca71103878f68a19655b0bf6fd9..6396e59922fc36c09bf88f36fbb89656b95efc0c 100644
--- a/crates/vmm/src/devices/virtio/gpu/mod.rs
+++ b/crates/vmm/src/devices/virtio/gpu/mod.rs
@@ -1374,6 +1374,57 @@ mod tests {
         );
     }
 
+    /// A context id the guest reuses after destroying it: a completion of the destroyed
+    /// incarnation still queued when the id comes back lets go of nothing of the new one,
+    /// whose fences the guest's one per-device counter numbers after it (Linux
+    /// virtgpu_fence.c, `++drv->current_fence_id`); the new incarnation's own fence does.
+    #[test]
+    fn a_reused_context_id_takes_no_completion_of_the_destroyed_one() {
+        let (mut s, log, mem) = served();
+        context(&mut s, &mem, 1, 4);
+        let fenced = |fence: u64| Header {
+            kind: cmd::SUBMIT_3D,
+            flags: FLAG_FENCE | FLAG_INFO_RING_IDX,
+            fence_id: fence,
+            ctx_id: 1,
+            ring_idx: 1,
+        };
+        let n = HEADER as u32;
+        assert_eq!(ask(&mut s, &mem, 10, fenced(10), &le(&[4, 0, 0])).0, []);
+        let (used, ..) = ask(&mut s, &mem, 11, plain(cmd::CTX_DESTROY, 1), &[]);
+        assert_eq!(used, [(10, n), (11, n)]);
+        assert_eq!(context(&mut s, &mem, 1, 4), resp::OK_NODATA);
+        assert_eq!(ask(&mut s, &mem, 12, fenced(11), &le(&[4, 0, 0])).0, []);
+        assert_eq!(
+            calls(&log),
+            [
+                "create 1 4 probe",
+                "submit 1 4",
+                "fence 1 1 10",
+                "destroy 1",
+                "create 1 4 probe",
+                "submit 1 4",
+                "fence 1 1 11"
+            ]
+        );
+        assert_eq!(
+            s.signalled(Signal {
+                ctx: 1,
+                ring: 1,
+                fence: 10
+            }),
+            []
+        );
+        assert_eq!(
+            s.signalled(Signal {
+                ctx: 1,
+                ring: 1,
+                fence: 11
+            }),
+            [(12, n)]
+        );
+    }
+
     /// A queue in guest memory, its driver's side.
     struct Ring {
         size: u16,
