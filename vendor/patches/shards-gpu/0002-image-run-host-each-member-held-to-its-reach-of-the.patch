+fn each_member_reaches_its_own_names() {
+    use shards_agentfile::agentfile::{self as af, TargetKind};
+    let text = "FROM alpine\nHARNESS codex FROM ./codex\nAGENT helper FROM ./helper\nAGENT idle FROM ./idle\n\
