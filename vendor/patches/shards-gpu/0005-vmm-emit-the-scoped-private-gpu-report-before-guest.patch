+fn collected_args(mut args: impl Iterator<Item = OsString>) -> std::io::Result<Vec<OsString>> {
+    let (_, bound) = args.size_hint();
+    let bound = bound.ok_or(std::io::ErrorKind::InvalidInput)?;
+    let mut words = Vec::new();
+    words
