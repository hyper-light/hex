+#[cfg(unix)]
+fn lifeline_fd(args: &[OsString]) -> std::io::Result<Option<i32>> {
+    let mut words = args.iter();
+    let mut managed = false;
+    let mut lifeline = None;
+    while let Some((word, value)) = crate::spec::next_word(&mut words) {
+        if word == "--" {
