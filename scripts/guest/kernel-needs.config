# What the guest's kernel must have for Hex (docs/design/shards-guest.md §4, §4a), checked by
# scripts/guest/build.sh against the config Shards' scripts/build-kernel.sh made. Each is in
# Firecracker's 6.18 configs or Shards' fragments today; one missing fails the build, and is then
# added as a Hex fragment.
# The channel to the host (§3): vsock over virtio.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# The initramfs init runs from, and what init mounts (§4).
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# Bind mounts' shares (§4a): virtio-fs, which is FUSE on virtio queues.
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
# The oci class (goal 5): cgroup v2 controllers and device programs, namespaces, seccomp,
# overlayfs, and what a runtime-spec container mounts.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_CGROUP=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_OVERLAY_FS=y
CONFIG_UNIX=y
CONFIG_UNIX98_PTYS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSVIPC=y
CONFIG_PSI=y
CONFIG_VETH=y
