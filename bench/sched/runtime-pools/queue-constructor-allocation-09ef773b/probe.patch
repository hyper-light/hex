@@ -0,0 +1,162 @@
+//! CP-T7.3: cumulative Rust/System layout accounting for the ignored real-Queued diagnostic.
+//! Adapted from bench/sched/runtime-pools/allocation-probe/benches/main.rs. No counter resets,
+//! allocator logging, OS queries or allocation inside these hooks. ROOT alone executes the probe.
+
+#![allow(unsafe_code)]
+
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+use serde_json::{Value, json};
+
+struct CountedSystem;
+
+#[global_allocator]
+static ALLOCATOR: CountedSystem = CountedSystem;
+static ALLOCATIONS: AtomicU64 = AtomicU64::new(0);
+static DEALLOCATIONS: AtomicU64 = AtomicU64::new(0);
+static REALLOCATIONS: AtomicU64 = AtomicU64::new(0);
+static REQUESTED_BYTES: AtomicU64 = AtomicU64::new(0);
+static DEALLOCATED_LAYOUT_BYTES: AtomicU64 = AtomicU64::new(0);
+static LIVE_BYTES: AtomicU64 = AtomicU64::new(0);
+static ALLOCATION_FAILURES: AtomicU64 = AtomicU64::new(0);
+static ACCOUNTING_INVALID: AtomicBool = AtomicBool::new(false);
+
+fn add(counter: &AtomicU64, value: u64) {
+    if counter
+        .try_update(Ordering::Relaxed, Ordering::Relaxed, |old| {
+            old.checked_add(value)
+        })
+        .is_err()
+    {
+        ACCOUNTING_INVALID.store(true, Ordering::Relaxed);
+    }
+}
+
+fn subtract(counter: &AtomicU64, value: u64) {
+    if counter
+        .try_update(Ordering::Relaxed, Ordering::Relaxed, |old| {
+            old.checked_sub(value)
+        })
+        .is_err()
+    {
+        ACCOUNTING_INVALID.store(true, Ordering::Relaxed);
+    }
+}
+
+fn bytes(size: usize) -> u64 {
+    match u64::try_from(size) {
+        Ok(value) => value,
+        Err(_) => {
+            ACCOUNTING_INVALID.store(true, Ordering::Relaxed);
+            0
+        }
+    }
+}
+
+// SAFETY: every pointer/layout is forwarded unchanged to System exactly once. Only nonallocating
+// atomics account for successful operations; accounting cannot change a returned block or unwind.
+unsafe impl GlobalAlloc for CountedSystem {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: GlobalAlloc's caller supplies a valid nonzero layout, forwarded unchanged.
+        let pointer = unsafe { System.alloc(layout) };
+        if pointer.is_null() {
+            add(&ALLOCATION_FAILURES, 1);
+        } else {
+            add(&ALLOCATIONS, 1);
+            let size = bytes(layout.size());
+            add(&REQUESTED_BYTES, size);
+            add(&LIVE_BYTES, size);
+        }
+        pointer
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: the original allocation contract is preserved, including zero initialization.
+        let pointer = unsafe { System.alloc_zeroed(layout) };
+        if pointer.is_null() {
+            add(&ALLOCATION_FAILURES, 1);
+        } else {
+            add(&ALLOCATIONS, 1);
+            let size = bytes(layout.size());
+            add(&REQUESTED_BYTES, size);
+            add(&LIVE_BYTES, size);
+        }
+        pointer
+    }
+
+    unsafe fn dealloc(&self, pointer: *mut u8, layout: Layout) {
+        // SAFETY: caller owns this live System block with its original layout. Nothing accesses
+        // the block after this one corresponding deallocation.
+        unsafe { System.dealloc(pointer, layout) };
+        add(&DEALLOCATIONS, 1);
+        let size = bytes(layout.size());
+        add(&DEALLOCATED_LAYOUT_BYTES, size);
+        subtract(&LIVE_BYTES, size);
+    }
+
+    unsafe fn realloc(&self, pointer: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        // SAFETY: caller supplies a live System block with its original layout and a valid
+        // nonzero new size. Null leaves the original allocation live, as System specifies.
+        let replacement = unsafe { System.realloc(pointer, layout, new_size) };
+        if replacement.is_null() {
+            add(&ALLOCATION_FAILURES, 1);
+        } else {
+            add(&REALLOCATIONS, 1);
+            add(&REQUESTED_BYTES, bytes(new_size));
+            if let Some(growth) = new_size.checked_sub(layout.size()) {
+                add(&LIVE_BYTES, bytes(growth));
+            } else if let Some(shrink) = layout.size().checked_sub(new_size) {
+                subtract(&LIVE_BYTES, bytes(shrink));
+            }
+        }
+        replacement
+    }
+}
+
+/// Independent relaxed loads, not an atomic process-wide transaction. Other test threads would
+/// contaminate a measurement; ROOT must run only the exact ignored test with one test thread.
+#[derive(Clone, Copy)]
+pub(crate) struct Snapshot {
+    allocations: u64,
+    deallocations: u64,
+    reallocations: u64,
+    requested_bytes: u64,
+    deallocated_layout_bytes: u64,
+    live_bytes: u64,
+    allocation_failures: u64,
+    invalid: bool,
+}
+
+impl Snapshot {
+    pub(crate) fn now() -> Self {
+        Self {
+            allocations: ALLOCATIONS.load(Ordering::Relaxed),
+            deallocations: DEALLOCATIONS.load(Ordering::Relaxed),
+            reallocations: REALLOCATIONS.load(Ordering::Relaxed),
+            requested_bytes: REQUESTED_BYTES.load(Ordering::Relaxed),
+            deallocated_layout_bytes: DEALLOCATED_LAYOUT_BYTES.load(Ordering::Relaxed),
+            live_bytes: LIVE_BYTES.load(Ordering::Relaxed),
+            allocation_failures: ALLOCATION_FAILURES.load(Ordering::Relaxed),
+            invalid: ACCOUNTING_INVALID.load(Ordering::Relaxed),
+        }
+    }
+
+    pub(crate) fn valid(self) -> bool {
+        !self.invalid
+    }
+
+    /// Formatting allocates, so callers invoke this only after every measurement snapshot.
+    pub(crate) fn value(self) -> Value {
+        json!({
+            "allocations": self.allocations,
+            "deallocations": self.deallocations,
+            "reallocations": self.reallocations,
+            "requested_bytes": self.requested_bytes,
+            "deallocated_layout_bytes": self.deallocated_layout_bytes,
+            "live_bytes": self.live_bytes,
+            "allocation_failures": self.allocation_failures,
+            "accounting_invalid": self.invalid,
+        })
+    }
+}
