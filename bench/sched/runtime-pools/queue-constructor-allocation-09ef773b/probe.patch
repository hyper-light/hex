index 318328ce..54b6c245 100644
--- a/crates/hex-node/src/scheduler/tests.rs
+++ b/crates/hex-node/src/scheduler/tests.rs
@@ -2,6 +2,92 @@ use super::*;
 use hex_api::{Bounds, ClassSpec};
 use hex_sim::model::{Ask, Demand, Kind, Resources};
 
+/// CP-T7.3: ROOT-only constructor allocation diagnostic using the actual production queue item.
+/// Never run as a normal check: ROOT selects both mode and peer count and records native context.
+#[test]
+#[ignore = "ROOT-only allocation probe; requires explicit mode/count and one test thread"]
+fn cp_t7_3_actual_queued_channel_allocation_probe() -> Result<(), String> {
+    use crate::queue_allocation_probe::Snapshot;
+
+    // Both modes retain the same vector element type and storage for every snapshot.
+    enum ProbeSender {
+        Bounded {
+            _sender: SyncSender<Queued>,
+        },
+        Linked {
+            _sender: std::sync::mpsc::Sender<Queued>,
+        },
+    }
+    type Pair = (ProbeSender, Receiver<Queued>);
+
+    let mode = std::env::var("HEX_QUEUE_ALLOCATION_MODE")
+        .map_err(|e| format!("require HEX_QUEUE_ALLOCATION_MODE=bounded|linked: {e}"))?;
+    let bounded = match mode.as_str() {
+        "bounded" => true,
+        "linked" => false,
+        _ => return Err("HEX_QUEUE_ALLOCATION_MODE must be bounded or linked".into()),
+    };
+    let peer_text = std::env::var("HEX_QUEUE_ALLOCATION_PEERS")
+        .map_err(|e| format!("require explicit positive HEX_QUEUE_ALLOCATION_PEERS: {e}"))?;
+    let peers: usize = peer_text
+        .parse()
+        .map_err(|e| format!("invalid HEX_QUEUE_ALLOCATION_PEERS: {e}"))?;
+    if peers == 0 {
+        return Err("HEX_QUEUE_ALLOCATION_PEERS must be positive".into());
+    }
+    let mut pairs: Vec<Pair> = Vec::new();
+    pairs
+        .try_reserve_exact(peers)
+        .map_err(|e| format!("fixture pair vector reservation failed: {e}"))?;
+
+    let before_construct = Snapshot::now();
+    for _ in 0..peers {
+        let pair = if bounded {
+            let (sender, receiver) = sync_channel::<Queued>(crate::records::MOST);
+            (ProbeSender::Bounded { _sender: sender }, receiver)
+        } else {
+            let (sender, receiver) = std::sync::mpsc::channel::<Queued>();
+            (ProbeSender::Linked { _sender: sender }, receiver)
+        };
+        pairs.push(pair);
+    }
+    std::hint::black_box(&pairs);
+    let while_held = Snapshot::now();
+    pairs.clear(); // Drop both typed endpoints; retain the vector allocation through reporting.
+    let after_drop = Snapshot::now();
+
+    // No formatting/stdout work occurs until all snapshots have been collected.
+    println!(
+        "{}",
+        serde_json::json!({
+            "kind": "actual-scheduler-Queued-channel-constructor-allocation",
+            "mode": mode,
+            "peers": peers,
+            "queued_type": std::any::type_name::<Queued>(),
+            "queued_size_bytes": std::mem::size_of::<Queued>(),
+            "original_capacity": crate::records::MOST,
+            "pair_size_bytes": std::mem::size_of::<Pair>(),
+            "pair_vector_capacity": pairs.capacity(),
+            "debug_assertions": cfg!(debug_assertions),
+            "target_os": std::env::consts::OS,
+            "target_arch": std::env::consts::ARCH,
+            "before_construct": before_construct.value(),
+            "while_held": while_held.value(),
+            "after_drop": after_drop.value(),
+            "counter_scope": "process-global cumulative successful Rust/System layout requests; no resets",
+            "requested_bytes_semantics": "alloc/alloc_zeroed size plus full successful realloc new_size",
+            "deallocated_layout_bytes_semantics": "dealloc layouts only; realloc replacement is tracked in live_bytes",
+            "snapshot_scope": "independent relaxed loads; run this exact ignored test alone",
+            "scope_limit": "constructor mechanism only; no Service startup, RSS, kernel, copied-byte or leak proof",
+        })
+    );
+    std::hint::black_box((&mode, &peer_text, &pairs));
+    if !before_construct.valid() || !while_held.valid() || !after_drop.valid() {
+        return Err("allocator accounting overflowed/underflowed; snapshots are invalid".into());
+    }
+    Ok(())
+}
+
