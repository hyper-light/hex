// bench/competitive/probes: by which kernel path the teardown of earlier boxes, or anything else, delays a create
// (goal 16; create_tail.md). Run by create_tail_whose.sh beside create_tail.sh, in a privileged container, with the
// create CPUs' first and last as $1 and $2; create_tail_whose_test.py holds it to what follows.
//
// It names nothing by a kernel address and prints none: the record host hides them (adacachy2, kernel.kptr_restrict=2:
// /proc/kallsyms reads zero even to root, so bpftrace's kaddr(), ksym() and kstack's names fail there). Its probes
// attach by name, which the kernel resolves, and the three things an address named before it learns in the kernel:
// - cgroup_mutex is the mutex a task waits for inside cgroup_kn_lock_live, which takes that one alone (kernel/cgroup/
//   cgroup.c: cgroup_lock(), or cgroup_lock_and_drain_offline's);
// - the threadgroup rwsem is the per-CPU rwsem a fork waits to read inside cgroup_can_fork (cgroup_css_set_fork's
//   cgroup_threadgroup_change_begin; the hotplug lock's readers wait only on a hotplug, which no record makes);
// - a work item's function is the one workqueue_execute_start gave the kworker that function's own probe fires on.
// A learning that disagrees with the first is counted in @learned_otherwise, so the record says if a rule failed.
// A wait's holder is named by its comm and its window: a mutex's or an rwsem's owner word (struct mutex, struct
// rw_semaphore: a task, its low three bits flags, an rwsem's bit 0 its readers'), or the task that took a per-CPU rwsem
// to write. The windows, outermost first: fork (kernel_clone), cgroup mkdir, cgroup rmdir, kernfs write (a cgroupfs or
// sysfs file's), css kill (css_killed_work_fn), css release (css_release_work_fn), css free (css_free_rwork_fn),
// kernfs notify (kernfs_notify_workfn: a cgroup file's change told to every superblock of its root), mount teardown
// (cleanup_mnt, from a task's return or delayed_mntput's work) and netns teardown (cleanup_net).
// Stacks need the addresses, so none are taken: windows, wakers and workqueues stand in for them.
// Each delete() is of a key known made, or guarded: bpftrace warns at every delete of a missing key.
// A per-CPU kernel thread's comm is keyed by its kind (kworker/3:2 as kworker): a teardown that blocks on
// cgroup_mutex makes the workqueues start kworkers by the hundred, and their names would fill every map (4,096 keys).
// The kind is an integer and its name is looked up as the key is made (@kname): a string variable given a shorter
// string keeps its old one's tail past the end (bpftrace copies to the new end), so one name printed many times over
// (whose-noowner-1f705e80-r2: @preempted_by's 3,781 keys). No string variable here is given a second string.
//
// A create's threads: Hex's (hex, hex-serve, hex-socket-worker, hex-ahead and the rest), seam_oci's and the bundles'
// programs (sleep, true). Its maps, each bounded by what it keeps (bpftrace's 4,096 keys a map): lock waits by waiter,
// lock and holder (a create's thread's, any on a cgroup lock learned, the teardown's own); css kills', releases' and
// frees' cost, where kills run and where they are queued; each controller's offline cost; the kernfs notify work's,
// a mount's teardown's and a netns teardown's cost and where each ran; work items (by workqueue and learned function)
// and softirqs on the create CPUs; each preemption of a create's thread by its preempter and what ran on its CPU
// meanwhile; each sleep of one over 500 us by its window, its state and its waker.

BEGIN
{
  @t0 = nsecs;
  @wname[1] = "fork"; @wname[2] = "cgroup mkdir"; @wname[3] = "cgroup rmdir"; @wname[4] = "kernfs write";
  @wname[5] = "css kill"; @wname[6] = "css release"; @wname[7] = "css free"; @wname[8] = "kernfs notify";
  @wname[9] = "mount teardown"; @wname[10] = "netns teardown";
  @state[1] = "S"; @state[2] = "D"; @state[4] = "T"; @state[8] = "t"; @state[64] = "P"; @state[128] = "I";
  @vec[0] = "HI"; @vec[1] = "TIMER"; @vec[2] = "NET_TX"; @vec[3] = "NET_RX"; @vec[4] = "BLOCK"; @vec[5] = "IRQ_POLL";
  @vec[6] = "TASKLET"; @vec[7] = "SCHED"; @vec[8] = "HRTIMER"; @vec[9] = "RCU";
  @lockname[1] = "spinlock"; @lockname[2] = "cgroup_mutex"; @lockname[3] = "threadgroup rwsem"; @lockname[4] = "mutex";
  @lockname[5] = "percpu rwsem"; @lockname[6] = "rtmutex"; @lockname[7] = "rwsem"; @lockname[8] = "rwlock";
  // A kind's name replaces a whole comm, so each value is a comm's 16 bytes (the map's type is its widest value's, and
  // bpftrace zeroes a value's rest): a literal copied over a comm would leave the comm's tail after its end.
  @kname[0] = comm; @kname[1] = "kworker"; @kname[2] = "ksoftirqd"; @kname[3] = "migration"; @kname[4] = "swapper";
  @kname[5] = "irq thread"; @kname[6] = "rcuc"; @kname[7] = "rcuop"; @kname[8] = "cpuhp"; @kname[9] = "readers";
  @kname[10] = ""; delete(@kname[0]);
  @pname[0] = "nothing traced"; @pname[1] = "a css kill"; @pname[2] = "a css release"; @pname[3] = "a kernfs notify";
  @pname[4] = "a netns teardown"; @pname[5] = "a mount teardown"; @pname[6] = "other work";
  printf("whose attached\n");
}

// The windows: set by the outermost, ended by the one that set it.
fentry:vmlinux:kernel_clone / @win[tid] == 0 / { @win[tid] = 1; }
fexit:vmlinux:kernel_clone / @win[tid] == 1 / { delete(@win[tid]); }
fentry:vmlinux:cgroup_mkdir / @win[tid] == 0 / { @win[tid] = 2; }
fexit:vmlinux:cgroup_mkdir / @win[tid] == 2 / { delete(@win[tid]); }
fentry:vmlinux:cgroup_rmdir / @win[tid] == 0 / { @win[tid] = 3; }
fexit:vmlinux:cgroup_rmdir / @win[tid] == 3 / { delete(@win[tid]); }
fentry:vmlinux:kernfs_fop_write_iter / @win[tid] == 0 / { @win[tid] = 4; }
fexit:vmlinux:kernfs_fop_write_iter / @win[tid] == 4 / { delete(@win[tid]); }

// Where cgroup_mutex and the threadgroup rwsem are learned.
fentry:vmlinux:cgroup_kn_lock_live { @learn[tid] = 1; }
fexit:vmlinux:cgroup_kn_lock_live / @learn[tid] / { delete(@learn[tid]); }
fentry:vmlinux:cgroup_can_fork { @learn[tid] = 2; }
fexit:vmlinux:cgroup_can_fork / @learn[tid] / { delete(@learn[tid]); }

// Who takes a per-CPU rwsem to write: its waiters' holder.
fentry:vmlinux:percpu_down_write
{
  $kw = 0;
  if (strncmp(comm, "kworker/", 8) == 0) { $kw = 1; } else if (strncmp(comm, "ksoftirqd/", 10) == 0) { $kw = 2; }
  else if (strncmp(comm, "migration/", 10) == 0) { $kw = 3; } else if (strncmp(comm, "swapper/", 8) == 0) { $kw = 4; }
  else if (strncmp(comm, "irq/", 4) == 0) { $kw = 5; } else if (strncmp(comm, "rcuc/", 5) == 0) { $kw = 6; }
  else if (strncmp(comm, "rcuop/", 6) == 0) { $kw = 7; } else if (strncmp(comm, "cpuhp/", 6) == 0) { $kw = 8; }
  if ($kw) { @pwc[(uint64)args.sem] = @kname[$kw]; } else { @pwc[(uint64)args.sem] = comm; }
  @pww[(uint64)args.sem] = @win[tid];
}
fentry:vmlinux:percpu_up_write / @pwc[(uint64)args.sem] != "" / { delete(@pwc[(uint64)args.sem]); delete(@pww[(uint64)args.sem]); }

// The teardown's work items: their cost, where they run, and their functions learned.
fentry:vmlinux:css_killed_work_fn
{
  @win[tid] = 5; @kill_t[tid] = nsecs; @kills_on[cpu]++;
  if (@wf[tid]) { @fname[@wf[tid]] = "css_killed_work_fn"; }
}
fexit:vmlinux:css_killed_work_fn / @kill_t[tid] /
{
  $d = (nsecs - @kill_t[tid]) / 1000;
  @css_kill_us = hist($d); @css_kill_ran_on_cpu_us[cpu] = sum($d);
  delete(@kill_t[tid]); delete(@win[tid]);
}
fentry:vmlinux:css_release_work_fn
{
  @win[tid] = 6; @release_t[tid] = nsecs; @releases_on[cpu]++;
  if (@wf[tid]) { @fname[@wf[tid]] = "css_release_work_fn"; }
}
fexit:vmlinux:css_release_work_fn / @release_t[tid] /
{
  $d = (nsecs - @release_t[tid]) / 1000;
  @css_release_us = hist($d); @css_release_ran_on_cpu_us[cpu] = sum($d);
  delete(@release_t[tid]); delete(@win[tid]);
}
fentry:vmlinux:css_free_rwork_fn
{
  @win[tid] = 7; @free_t[tid] = nsecs;
  if (@wf[tid]) { @fname[@wf[tid]] = "css_free_rwork_fn"; }
}
fexit:vmlinux:css_free_rwork_fn / @free_t[tid] /
{
  @css_free_us = hist((nsecs - @free_t[tid]) / 1000);
  delete(@free_t[tid]); delete(@win[tid]);
}

// The rest of what earlier boxes leave the host to do: each cgroup file's change told to every superblock its kernfs
// root has, a mount's teardown, a network namespace's. Each its cost, where it runs, and its work function learned.
fentry:vmlinux:kernfs_notify_workfn
{
  @win[tid] = 8; @notify_t[tid] = nsecs; @notifies_on[cpu]++;
  if (@wf[tid]) { @fname[@wf[tid]] = "kernfs_notify_workfn"; }
}
fexit:vmlinux:kernfs_notify_workfn / @notify_t[tid] /
{
  $d = (nsecs - @notify_t[tid]) / 1000;
  @kernfs_notify_us = hist($d); @kernfs_notify_ran_on_cpu_us[cpu] = sum($d);
  delete(@notify_t[tid]); delete(@win[tid]);
}
fentry:vmlinux:delayed_mntput / @wf[tid] / { @fname[@wf[tid]] = "delayed_mntput"; }
fentry:vmlinux:cleanup_mnt
{
  if (@win[tid] == 0) { @win[tid] = 9; }
  @mnt_t[tid] = nsecs; @mounts_on[cpu]++;
}
fexit:vmlinux:cleanup_mnt / @mnt_t[tid] /
{
  $d = (nsecs - @mnt_t[tid]) / 1000;
  @mount_teardown_us = hist($d); @mount_teardown_ran_on_cpu_us[cpu] = sum($d);
  delete(@mnt_t[tid]);
  if (@win[tid] == 9) { delete(@win[tid]); }
}
fentry:vmlinux:cleanup_net
{
  @win[tid] = 10; @net_t[tid] = nsecs; @netns_on[cpu]++;
  if (@wf[tid]) { @fname[@wf[tid]] = "cleanup_net"; }
}
fexit:vmlinux:cleanup_net / @net_t[tid] /
{
  $d = (nsecs - @net_t[tid]) / 1000;
  @netns_teardown_us = hist($d); @netns_teardown_ran_on_cpu_us[cpu] = sum($d);
  delete(@net_t[tid]); delete(@win[tid]);
}

// Each controller's offline, within a css kill.
fentry:vmlinux:mem_cgroup_css_offline { @memcg_t[tid] = nsecs; }
fexit:vmlinux:mem_cgroup_css_offline / @memcg_t[tid] / { @offline_us["memory"] = hist((nsecs - @memcg_t[tid]) / 1000); delete(@memcg_t[tid]); }
fentry:vmlinux:drain_all_stock { @drain_t[tid] = nsecs; }
fexit:vmlinux:drain_all_stock / @drain_t[tid] / { @offline_us["memory: drain_all_stock"] = hist((nsecs - @drain_t[tid]) / 1000); delete(@drain_t[tid]); }
fentry:vmlinux:lru_gen_offline_memcg { @lru_t[tid] = nsecs; }
fexit:vmlinux:lru_gen_offline_memcg / @lru_t[tid] / { @offline_us["memory: lru_gen_offline_memcg"] = hist((nsecs - @lru_t[tid]) / 1000); delete(@lru_t[tid]); }
fentry:vmlinux:cpu_cgroup_css_offline { @cpu_t[tid] = nsecs; }
fexit:vmlinux:cpu_cgroup_css_offline / @cpu_t[tid] / { @offline_us["cpu"] = hist((nsecs - @cpu_t[tid]) / 1000); delete(@cpu_t[tid]); }
fentry:vmlinux:blkcg_css_offline { @io_t[tid] = nsecs; }
fexit:vmlinux:blkcg_css_offline / @io_t[tid] / { @offline_us["io"] = hist((nsecs - @io_t[tid]) / 1000); delete(@io_t[tid]); }
fentry:vmlinux:cpuset_css_offline { @cpuset_t[tid] = nsecs; }
fexit:vmlinux:cpuset_css_offline / @cpuset_t[tid] / { @offline_us["cpuset"] = hist((nsecs - @cpuset_t[tid]) / 1000); delete(@cpuset_t[tid]); }

// Work items: each one's workqueue, held from its queueing to its start; on the create CPUs, its time.
tracepoint:workqueue:workqueue_queue_work
{
  $q = str(args.workqueue);
  @wqn[args.work] = $q;
  if (@fname[(uint64)args.function] == "css_killed_work_fn") {
    $kq = 0;
    if (strncmp(comm, "kworker/", 8) == 0) { $kq = 1; } else if (strncmp(comm, "ksoftirqd/", 10) == 0) { $kq = 2; }
    else if (strncmp(comm, "migration/", 10) == 0) { $kq = 3; } else if (strncmp(comm, "swapper/", 8) == 0) { $kq = 4; }
    else if (strncmp(comm, "irq/", 4) == 0) { $kq = 5; } else if (strncmp(comm, "rcuc/", 5) == 0) { $kq = 6; }
    else if (strncmp(comm, "rcuop/", 6) == 0) { $kq = 7; } else if (strncmp(comm, "cpuhp/", 6) == 0) { $kq = 8; }
    @css_kill_queued_on_cpu[args.cpu] = count();
    if ($kq) { @css_kill_queued_by[@kname[$kq]] = count(); } else { @css_kill_queued_by[comm] = count(); }
  }
}
tracepoint:workqueue:workqueue_execute_start
{
  @wf[tid] = (uint64)args.function; @works_on[cpu]++;
  if (cpu >= $1 && cpu <= $2) { @ws[tid] = nsecs; @wq[tid] = @wqn[args.work]; }
  if (@wqn[args.work] != "") { delete(@wqn[args.work]); }
}
tracepoint:workqueue:workqueue_execute_end
{
  if (@ws[tid]) {
    $f = @fname[@wf[tid]];
    $q = @wq[tid];
    @work_on_create_cpus_us[$q, $f] = sum((nsecs - @ws[tid]) / 1000);
    @work_on_create_cpus_n[$q, $f] = count();
    delete(@ws[tid]); delete(@wq[tid]);
  }
  if (@wf[tid]) { delete(@wf[tid]); }
}
tracepoint:irq:softirq_entry / cpu >= $1 && cpu <= $2 / { @si[cpu] = nsecs; @sv[cpu] = (int64)args.vec; }
tracepoint:irq:softirq_exit / cpu >= $1 && cpu <= $2 && @si[cpu] /
{
  $v = @vec[@sv[cpu]];
  @softirq_on_create_cpus_us[$v] = sum((nsecs - @si[cpu]) / 1000);
  delete(@si[cpu]);
}

// Lock waits. Flags (include/trace/events/lock.h): SPIN 0x1, READ 0x2, WRITE 0x4, RT 0x8, PERCPU 0x10, MUTEX 0x20.
tracepoint:lock:contention_begin
{
  $f = args.flags;
  $l = (uint64)args.lock_addr;
  if (@learn[tid] == 1 && ($f & 0x20)) {
    if (@cgm == 0) { @cgm = $l; printf("learned cgroup_mutex at %d ms, from %s's wait in cgroup_kn_lock_live\n", (nsecs - @t0) / 1000000, comm); }
    else if (@cgm != $l) { @learned_otherwise["cgroup_mutex"] = count(); }
  }
  if (@learn[tid] == 2 && ($f & 0x12) == 0x12) {
    if (@tgr == 0) { @tgr = $l; printf("learned the threadgroup rwsem at %d ms, from %s's wait in cgroup_can_fork\n", (nsecs - @t0) / 1000000, comm); }
    else if (@tgr != $l) { @learned_otherwise["threadgroup rwsem"] = count(); }
  }
  // A mutex's wait begins twice when it spins and then sleeps, and ends once (kernel/locking/mutex.c): it starts at
  // the first. Kept: a create's thread's waits, every wait for a cgroup lock learned, and the teardown's own.
  if (@cb[tid] == 0 && (strncmp(comm, "hex", 3) == 0 || comm == "seam_oci" || comm == "sleep" || comm == "true" || $l == @cgm || $l == @tgr || @win[tid] >= 5)) {
    @cb[tid] = nsecs; @cf[tid] = $f; @cl[tid] = $l; @hn[tid] = @kname[10]; @hw[tid] = 0;
    $o = (uint64)0;
    if ($f & 0x20) {
      $o = ((struct mutex *)args.lock_addr)->owner.counter & 0xfffffffffffffff8;
    } else if (($f & 0x19) == 0) {
      $w = (uint64)((struct rw_semaphore *)args.lock_addr)->owner.counter;
      if ($w & 0x1) { @hn[tid] = @kname[9]; } else { $o = $w & 0xfffffffffffffff8; }
    } else if ($f & 0x10) {
      @hn[tid] = @pwc[$l]; @hw[tid] = @pww[$l];
    }
    if ($o) {
      $t = (struct task_struct *)$o;
      $kh = 0;
      if (strncmp($t->comm, "kworker/", 8) == 0) { $kh = 1; } else if (strncmp($t->comm, "ksoftirqd/", 10) == 0) { $kh = 2; }
      else if (strncmp($t->comm, "migration/", 10) == 0) { $kh = 3; } else if (strncmp($t->comm, "swapper/", 8) == 0) { $kh = 4; }
      else if (strncmp($t->comm, "irq/", 4) == 0) { $kh = 5; } else if (strncmp($t->comm, "rcuc/", 5) == 0) { $kh = 6; }
      else if (strncmp($t->comm, "rcuop/", 6) == 0) { $kh = 7; } else if (strncmp($t->comm, "cpuhp/", 6) == 0) { $kh = 8; }
      if ($kh) { @hn[tid] = @kname[$kh]; } else { @hn[tid] = $t->comm; }
      @hw[tid] = @win[(uint64)$t->pid];
    }
  }
}
tracepoint:lock:contention_end / @cb[tid] /
{
  $d = (nsecs - @cb[tid]) / 1000;
  $f = @cf[tid];
  $l = @cl[tid];
  $k = 1;
  if ($l == @cgm) { $k = 2; }
  else if ($l == @tgr) { $k = 3; }
  else if ($f & 0x20) { $k = 4; }
  else if ($f & 0x10) { $k = 5; }
  else if ($f & 0x8) { $k = 6; }
  else if (($f & 0x1) == 0) { $k = 7; }
  else if ($f & 0x6) { $k = 8; }
  $name = @lockname[$k];
  $in = @wname[@win[tid]];
  $byin = @wname[@hw[tid]];
  $km = 0;
  if (strncmp(comm, "kworker/", 8) == 0) { $km = 1; } else if (strncmp(comm, "ksoftirqd/", 10) == 0) { $km = 2; }
  else if (strncmp(comm, "migration/", 10) == 0) { $km = 3; } else if (strncmp(comm, "swapper/", 8) == 0) { $km = 4; }
  else if (strncmp(comm, "irq/", 4) == 0) { $km = 5; } else if (strncmp(comm, "rcuc/", 5) == 0) { $km = 6; }
  else if (strncmp(comm, "rcuop/", 6) == 0) { $km = 7; } else if (strncmp(comm, "cpuhp/", 6) == 0) { $km = 8; }
  if ($km) {
    @lock_wait_total_us[@kname[$km], $in, $name, @hn[tid], $byin] = sum($d);
    @lock_wait_n[@kname[$km], $in, $name, @hn[tid], $byin] = count();
  } else {
    @lock_wait_total_us[comm, $in, $name, @hn[tid], $byin] = sum($d);
    @lock_wait_n[comm, $in, $name, @hn[tid], $byin] = count();
  }
  if (strncmp(comm, "hex", 3) == 0 || comm == "seam_oci" || comm == "sleep" || comm == "true") {
    @create_lock_wait_us[$in, $name, @hn[tid], $byin] = hist($d);
  }
  delete(@cb[tid]); delete(@cf[tid]); delete(@cl[tid]); delete(@hn[tid]); delete(@hw[tid]);
}

// A create's thread off its CPU: preempted (its state bits 0; TASK_REPORT_MAX, 0x100, marks it) or asleep.
tracepoint:sched:sched_switch
{
  if (strncmp(args.prev_comm, "hex", 3) == 0 || args.prev_comm == "seam_oci" || args.prev_comm == "sleep" || args.prev_comm == "true") {
    $st = args.prev_state & 0xff;
    // Its last switch reports X (0x10) or Z (0x20): it never runs again, so it leaves nothing behind.
    if (($st & 0x30) == 0) {
      $p = args.prev_pid;
      @out[$p] = nsecs; @outcpu[$p] = cpu; @outst[$p] = $st + 1; @outwin[$p] = @win[(uint64)$p];
      @outk[$p] = @kills_on[cpu]; @outr[$p] = @releases_on[cpu]; @outn[$p] = @notifies_on[cpu];
      @outt[$p] = @netns_on[cpu]; @outm[$p] = @mounts_on[cpu]; @outw[$p] = @works_on[cpu];
      @wk[$p] = @kname[10]; @wkw[$p] = 0;
      if ($st == 0) {
        $kp = 0;
        if (strncmp(args.next_comm, "kworker/", 8) == 0) { $kp = 1; } else if (strncmp(args.next_comm, "ksoftirqd/", 10) == 0) { $kp = 2; }
        else if (strncmp(args.next_comm, "migration/", 10) == 0) { $kp = 3; } else if (strncmp(args.next_comm, "swapper/", 8) == 0) { $kp = 4; }
        else if (strncmp(args.next_comm, "irq/", 4) == 0) { $kp = 5; } else if (strncmp(args.next_comm, "rcuc/", 5) == 0) { $kp = 6; }
        else if (strncmp(args.next_comm, "rcuop/", 6) == 0) { $kp = 7; } else if (strncmp(args.next_comm, "cpuhp/", 6) == 0) { $kp = 8; }
        if ($kp) { @preempted_by[args.prev_comm, @kname[$kp]] = count(); }
        else { @preempted_by[args.prev_comm, args.next_comm] = count(); }
      }
    }
  }
  if (@out[args.next_pid]) {
    $n = args.next_pid;
    $d = (nsecs - @out[$n]) / 1000;
    $c = @outcpu[$n];
    if (@outst[$n] == 1) {
      $cls = 0;
      if (@kills_on[$c] > @outk[$n]) { $cls = 1; }
      else if (@releases_on[$c] > @outr[$n]) { $cls = 2; }
      else if (@notifies_on[$c] > @outn[$n]) { $cls = 3; }
      else if (@netns_on[$c] > @outt[$n]) { $cls = 4; }
      else if (@mounts_on[$c] > @outm[$n]) { $cls = 5; }
      else if (@works_on[$c] > @outw[$n]) { $cls = 6; }
      @preempt_us[@pname[$cls]] = hist($d); @preempt_total_us[@pname[$cls]] = sum($d);
    } else if ($d > 500) {
      $s = @state[@outst[$n] - 1];
      $in = @wname[@outwin[$n]];
      $byin = @wname[@wkw[$n]];
      @sleep_slow_us[args.next_comm, $s, $in, @wk[$n], $byin] = sum($d);
    }
    delete(@out[$n]); delete(@outcpu[$n]); delete(@outst[$n]); delete(@outwin[$n]); delete(@outk[$n]);
    delete(@outr[$n]); delete(@outn[$n]); delete(@outt[$n]); delete(@outm[$n]); delete(@outw[$n]); delete(@wk[$n]);
    delete(@wkw[$n]);
  }
}
// Who woke a sleeping create's thread, and in which window.
tracepoint:sched:sched_waking / @out[args.pid] /
{
  $kw = 0;
  if (strncmp(comm, "kworker/", 8) == 0) { $kw = 1; } else if (strncmp(comm, "ksoftirqd/", 10) == 0) { $kw = 2; }
  else if (strncmp(comm, "migration/", 10) == 0) { $kw = 3; } else if (strncmp(comm, "swapper/", 8) == 0) { $kw = 4; }
  else if (strncmp(comm, "irq/", 4) == 0) { $kw = 5; } else if (strncmp(comm, "rcuc/", 5) == 0) { $kw = 6; }
  else if (strncmp(comm, "rcuop/", 6) == 0) { $kw = 7; } else if (strncmp(comm, "cpuhp/", 6) == 0) { $kw = 8; }
  if ($kw) { @wk[args.pid] = @kname[$kw]; } else { @wk[args.pid] = comm; }
  @wkw[args.pid] = @win[tid];
}

END
{
  clear(@t0); clear(@wname); clear(@state); clear(@vec); clear(@lockname); clear(@kname); clear(@pname); clear(@win);
  clear(@learn); clear(@pwc); clear(@pww); clear(@kill_t); clear(@kills_on); clear(@fname); clear(@release_t);
  clear(@releases_on); clear(@free_t); clear(@notify_t); clear(@notifies_on); clear(@mnt_t); clear(@mounts_on);
  clear(@net_t); clear(@netns_on); clear(@memcg_t); clear(@drain_t); clear(@lru_t); clear(@cpu_t); clear(@io_t);
  clear(@cpuset_t); clear(@wqn); clear(@wf); clear(@works_on); clear(@ws); clear(@wq); clear(@si); clear(@sv);
  clear(@cgm); clear(@tgr); clear(@cb); clear(@cf); clear(@cl); clear(@hn); clear(@hw); clear(@out); clear(@outcpu);
  clear(@outst); clear(@outwin); clear(@outk); clear(@outr); clear(@outn); clear(@outt); clear(@outm); clear(@outw);
  clear(@wk); clear(@wkw);
}
